# iaq_hfis generated run artifacts -- never source, always reproducible from config + raw data.
# research_results/final/ is the ONE deliberate exception: a tracked, static publication
# snapshot built by `iaq_hfis finalize` (see docs/reproducibility.md). It lives
# outside data/iaq_hfis/ specifically so this rule never accidentally ignores it.
data/iaq_hfis/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/

# air-monitor secrets (mirrors air-monitor/.gitignore)
air-monitor/config/email_credentials.env

# air-monitor/ is its own nested git repo (separate project), not tracked here
air-monitor/

# legacy pre-air-monitor sensor scripts, superseded by air-monitor/scripts/run_pipeline.py
main.py
run_bme.py
run_scd.py
run_sps.py

# local Claude Code settings
.claude/

# scratch copy from 'iaq_hfis test-report'; the canonical copy is embedded by
# 'iaq_hfis finalize' into research_results/{exploratory,final}/test_report.*
/test_report.json
/test_report.md

# 2026-08 research run (task section 3/16): the frozen dataset snapshot itself
# (a full DuckDB copy + a CSV export of the interval-filtered rows) is raw
# sensor data, not a research artifact -- never committed. Its SHA256
# (dataset_sha256.txt) and the verification JSON alongside it ARE committed,
# so every downstream artifact can still cite exactly what data produced it.
research_results/runs/*/snapshot/*.duckdb
research_results/runs/*/snapshot/*.csv
# Per-masking-case resumability checkpoints for the missing-data-strategy
# experiment (task section 1/6) -- intermediate working state, not a result;
# the finished CSVs/plots under missing_data_strategy/ are the real artifacts.
research_results/runs/*/missing_data_strategy/_checkpoints/
