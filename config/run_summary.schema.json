{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iaq_hfis run summary (reproducibility metadata + optional evaluation, run-isolated)",
  "type": "object",
  "required": [
    "pipeline_run_id", "started_at", "finished_at", "status", "config_hash", "engine_version",
    "window_minutes", "computed_ts_range", "n_timestamps_processed", "n_snapshot_retries",
    "completeness_summary", "provisional_parameters_used", "environment",
    "selected_evaluation_run_id", "errors", "warnings"
  ],
  "properties": {
    "pipeline_run_id": {"type": "string"},
    "mode": {"type": "string", "enum": ["publication", "exploratory"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["success", "failed"]},
    "config_hash": {"type": "string"},
    "engine_version": {"type": "string"},
    "window_minutes": {"type": "integer"},
    "computed_ts_range": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
    "n_timestamps_processed": {"type": "integer", "minimum": 0},
    "n_snapshot_retries": {"type": "integer", "minimum": 0},
    "completeness_summary": {
      "type": "object",
      "required": ["OK", "PARTIAL", "FAILED"],
      "properties": {
        "OK": {"type": "integer", "minimum": 0},
        "PARTIAL": {"type": "integer", "minimum": 0},
        "FAILED": {"type": "integer", "minimum": 0}
      }
    },
    "provisional_parameters_used": {"type": "array", "items": {"type": "string"}},
    "dominant_component_frequency": {
      "type": "object",
      "description": "How often each component (A/V/M) won fuzzy_engine.determine_dominance's priority hierarchy, across every OK/PARTIAL computed_ts this run (FAILED rows have a null dominant_component and are excluded)."
    },
    "environment": {
      "type": "object",
      "required": ["iaq_hfis_version", "python_version", "duckdb_version", "platform", "processor", "cpu_count", "git_commit", "rule_generation_version"],
      "properties": {
        "iaq_hfis_version": {"type": "string"},
        "python_version": {"type": "string"},
        "duckdb_version": {"type": "string"},
        "platform": {"type": "string"},
        "processor": {"type": "string"},
        "cpu_count": {"type": ["integer", "null"]},
        "git_commit": {"type": ["string", "null"]},
        "git_tree_dirty": {"type": ["boolean", "null"]},
        "rule_generation_version": {"type": "string"}
      }
    },
    "performance": {
      "type": "object",
      "description": "Runtime/resource measurements for this pipeline run, taken on the actual execution host.",
      "properties": {
        "platform": {"type": "string"},
        "processor": {"type": "string"},
        "cpu_count": {"type": ["integer", "null"]},
        "total_runtime_seconds": {"type": "number"},
        "peak_memory_mb": {"type": "number"},
        "per_timestamp_latency_ms": {"type": "object"},
        "source_raw_row_count": {"type": "integer"},
        "derived_row_counts": {"type": "object"}
      }
    },
    "selected_evaluation_run_id": {
      "type": ["string", "null"],
      "description": "The single evaluation_run_id whose results are reported below, if evaluation has been run."
    },
    "evaluation": {
      "type": "object",
      "description": "Present only after 'iaq_hfis evaluate' has been run for this pipeline_run_id; baselines/agreement/masking/reference-case/stability/sensitivity/fault results for exactly the evaluation run named by selected_evaluation_run_id.",
      "properties": {
        "evaluation_run_id": {"type": "string"},
        "pipeline_run_id": {"type": "string"},
        "n_computed_ts_evaluated": {"type": "integer", "minimum": 0},
        "performance": {"type": "object"},
        "agreement": {"type": "array"},
        "masking": {"type": "array"},
        "reference_cases": {
          "type": "object",
          "description": "Consistency with predefined synthetic boundary-adjacent labels -- NOT an empirical accuracy estimate."
        },
        "stability": {
          "type": ["object", "null"],
          "description": "Multi-point stability: deterministic boundary-adjacent + random-comparison sample, all 3 methods. class_change_rate/prob_moved_better/prob_moved_worse are agreement-with-self-under-perturbation statistics, never accuracy (no ground truth involved).",
          "properties": {
            "n_samples": {"type": "integer"},
            "n_trials_per_sample": {"type": "integer"},
            "seed": {"type": "integer"},
            "by_method": {"type": "object", "description": "Overall summary per method."},
            "by_variable": {"type": "array", "description": "Summary per (method, selection_reason, boundary_channel)."},
            "by_original_class": {"type": "array", "description": "Summary per (method, original/baseline class)."}
          }
        },
        "sensitivity": {
          "type": "object",
          "description": "Multi-point sensitivity: deterministic stratified sample across the evaluated range.",
          "properties": {
            "n_sample_points": {"type": "integer"},
            "strata": {"type": "array", "items": {"type": "string"}},
            "by_parameter_value": {"type": "array"}
          }
        },
        "continuity": {
          "type": "object",
          "description": "HFIS vs CRISP-MAX vs WEIGHTED-MEAN boundary continuity experiment (deterministic input grids, favourable/acceptable/degraded contexts).",
          "properties": {
            "n_boundaries": {"type": "integer"},
            "n_contexts": {"type": "integer"},
            "contexts": {"type": "array", "items": {"type": "string"}},
            "grid_points_per_boundary": {"type": "integer"},
            "by_boundary_method": {"type": "array"},
            "smoothness_comparison": {"type": "object", "description": "Honest, non-cherry-picked HFIS-vs-CRISP-MAX Lipschitz-ratio smoothness comparison across every (boundary, context) pair tested."}
          }
        },
        "fault_injection": {
          "type": "object",
          "description": "Deterministic, labeled synthetic fault-injection benchmark -- separate from unlabeled real-data reason_code_frequency. calibration/validation are disjoint scenario sets (no data leakage); validation is the headline, publication-facing split.",
          "properties": {
            "n_scenarios": {"type": "integer"},
            "channels_covered": {"type": "array", "items": {"type": "string"}},
            "headline_dataset_split": {"type": "string", "enum": ["validation"]},
            "row_level_metrics_by_split": {"type": "object", "description": "Every affected sample counted individually, keyed by 'calibration'/'validation'."},
            "event_level_metrics_by_split": {"type": "object", "description": "Each injected fault counted once via one-to-one matching, keyed by 'calibration'/'validation'."},
            "metrics_by_reason_code": {"type": "array", "description": "Legacy alias: validation split's row-level metrics."},
            "false_rejection_rate_for_genuine_events": {"type": ["number", "null"]},
            "confirmation_recovery_rate": {"type": ["number", "null"]},
            "hampel_calibration": {"type": "object"}
          }
        },
        "status_proportions": {"type": "object"},
        "reason_code_frequency": {"type": "object"},
        "errors": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "readiness": {
      "type": "object",
      "description": "Structured artifact/manuscript readiness assessment -- see iaq_hfis.provenance.assess_readiness.",
      "properties": {
        "artifact_readiness": {
          "type": "object",
          "properties": {
            "ready": {"type": "boolean"},
            "blocking_issues": {"type": "array", "items": {"type": "string"}},
            "warnings": {"type": "array", "items": {"type": "string"}}
          }
        },
        "manuscript_readiness": {
          "type": "object",
          "properties": {
            "ready": {"type": "boolean"},
            "blocking_issues": {"type": "array", "items": {"type": "string"}},
            "unsupported_claims": {"type": "array", "items": {"type": "string"}},
            "warnings": {"type": "array", "items": {"type": "string"}}
          }
        },
        "scientific_blockers": {"type": "array", "items": {"type": "string"}},
        "unsupported_claims": {"type": "array", "items": {"type": "string"}},
        "provisional_parameters_used": {"type": "array", "items": {"type": "string"}},
        "parameters_covered_by_sensitivity_analysis": {"type": "array", "items": {"type": "string"}},
        "tests_executed": {"type": ["object", "null"]},
        "artifact_validation": {"type": ["object", "null"]}
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
